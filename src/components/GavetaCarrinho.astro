---
// Carrinho lateral. A casca vem pronta no HTML; as linhas são desenhadas por src/scripts/loja.ts
// a partir de GET /api/carrinho. Sem JavaScript, o ícone do carrinho continua indo para /carrinho.
import Simbolo from './Simbolo.astro';
---
<div class="gaveta-fundo" data-gaveta-fundo hidden></div>
<aside class="gaveta" data-gaveta role="dialog" aria-modal="true" aria-labelledby="gaveta-titulo" hidden>
  <div class="gaveta-topo">
    <h2 id="gaveta-titulo">Seu carrinho <span class="nota" data-gaveta-qtd></span></h2>
    <button type="button" class="gaveta-fechar" data-gaveta-fechar aria-label="Fechar carrinho"><Simbolo nome="fechar" /></button>
  </div>
  <p class="gaveta-aviso" data-gaveta-aviso hidden><Simbolo nome="check" tamanho={18} /> Produto adicionado ao carrinho</p>
  <ul class="gaveta-itens" data-gaveta-itens aria-live="polite"></ul>
  <div class="gaveta-vazia" data-gaveta-vazia hidden>
    <img src="/img/auri-320.webp" width="140" height="140" alt="" loading="lazy" />
    <p>Seu carrinho está vazio.</p>
    <a class="botao botao-primario" href="/produtos">Ver produtos</a>
  </div>
  <div class="gaveta-rodape" data-gaveta-rodape hidden>
    <p class="aviso aviso-erro" data-gaveta-problema hidden>Ajuste os itens marcados para continuar.</p>
    <div class="linha-total grande"><span>Subtotal</span><span data-gaveta-subtotal></span></div>
    <p class="nota">Frete e prazo no próximo passo. Pix aprovado na hora.</p>
    <a class="botao botao-primario botao-largo" href="/checkout" data-gaveta-checkout>Finalizar compra</a>
    <a class="botao botao-contorno botao-largo" href="/carrinho">Ver carrinho completo</a>
  </div>
</aside>
