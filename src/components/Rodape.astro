---
// Rodapé. No computador: colunas abertas. No celular: marca e contato em cima, as listas viram
// sanfonas fechadas (eram 20 links em fila, uma tela e meia de rolagem) e o legal fica compacto.
import Simbolo from './Simbolo.astro';
import type { Categoria } from '../lib/loja';
import { LOJA } from '../lib/loja';
interface Props { categorias: Categoria[]; }
const { categorias } = Astro.props;
const grupos = [
  { titulo: 'Comprar', links: [{ href: '/produtos', nome: 'Todos os produtos' }, ...categorias.map(c => ({ href: `/categoria/${c.slug}`, nome: c.nome }))] },
  { titulo: 'Ajuda', links: [
    { href: '/conta', nome: 'Minha conta' }, { href: '/pedido', nome: 'Rastrear pedido' }, { href: '/ajuda', nome: 'Dúvidas frequentes' },
    { href: '/frete-e-prazos', nome: 'Frete e prazos' }, { href: '/trocas-e-devolucoes', nome: 'Trocas e devoluções' }, { href: '/contato', nome: 'Fale com a gente' },
  ] },
  { titulo: 'Institucional', links: [
    { href: '/sobre', nome: 'Sobre a Geek Aura' }, { href: '/privacidade', nome: 'Política de privacidade' }, { href: '/termos', nome: 'Termos de uso' },
  ] },
];
---
<footer class="rodape">
  <div class="recipiente rodape-colunas">
    <div class="rodape-marca">
      <span class="marca-nome"><span class="geek">GEEK</span> <span class="aura">AURA</span></span>
      <p><strong>{LOJA.bordao}.</strong> Blocos de montar, jogos de cartas e colecionáveis.</p>
      <div class="rodape-contato">
        <a class="contato-botao" href="/ajuda"><Simbolo nome="busca" tamanho={18} /><span>Dúvidas frequentes<small>Entrega, pagamento e trocas</small></span></a>
        <a class="contato-botao" href={`mailto:${LOJA.email}`}><Simbolo nome="email" tamanho={18} /><span>E-mail<small>{LOJA.email}</small></span></a>
      </div>
    </div>
    {grupos.map(g => (
      <details class="rodape-grupo" open data-rodape-grupo>
        <summary class="rodape-titulo">{g.titulo}<span class="rodape-seta" aria-hidden="true"><Simbolo nome="direita" tamanho={18} /></span></summary>
        <nav aria-label={g.titulo}>{g.links.map(l => <a href={l.href}>{l.nome}</a>)}</nav>
      </details>
    ))}
  </div>
  <div class="recipiente rodape-pagamento">
    <span class="nota-clara">Pagamento seguro pelo Mercado Pago</span>
    <span class="selos"><span>Pix</span><span>Cartão</span><span>Boleto</span></span>
  </div>
  <div class="recipiente rodape-legal">
    <span>{LOJA.razaoSocial} · CNPJ {LOJA.cnpj}</span>
    <span>{LOJA.endereco}</span>
  </div>
</footer>

<script>
  // No celular as sanfonas começam fechadas; sem JavaScript ficam abertas e nada some.
  if (matchMedia('(max-width: 899px)').matches) {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-rodape-grupo]')) d.open = false;
  }
</script>
