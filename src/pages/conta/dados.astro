---
import Base from '../../layouts/Base.astro';
import PainelConta from '../../components/PainelConta.astro';
import Simbolo from '../../components/Simbolo.astro';
import { clienteAtual, gravarSessao, lerSessao } from '../../lib/conta';
import { envDe } from '../../lib/api';

const sessao = await lerSessao(Astro);
const cliente = await clienteAtual(envDe(Astro), sessao).catch(() => undefined);
if (!sessao || cliente === null) { await gravarSessao(Astro, null); return Astro.redirect('/entrar?volta=/conta/dados', 303); }
const tel = cliente?.telefone ?? '';
const telFormatado = tel.length === 11 ? `(${tel.slice(0, 2)}) ${tel.slice(2, 7)}-${tel.slice(7)}` : tel.length === 10 ? `(${tel.slice(0, 2)}) ${tel.slice(2, 6)}-${tel.slice(6)}` : tel;
---
<Base titulo="Meus dados" descricao="Seus dados na Geek Aura." noindex>
  <PainelConta atual="dados" nome={cliente?.nome ?? sessao.n} email={cliente?.email ?? ''}>
    <h1>Meus dados</h1>
    {!cliente ? (
      <p class="aviso aviso-info">Não conseguimos carregar seus dados agora. Atualize a página em instantes.</p>
    ) : (
      <form class="form-conta cartao-form" data-form-conta data-endpoint="/api/conta/dados" novalidate>
        <div class="linha-campos duas">
          <div class="campo"><label for="nome">Nome completo</label><input id="nome" name="nome" autocomplete="name" maxlength="120" required minlength="2" value={cliente.nome} /></div>
          <div class="campo"><label for="telefone">Celular com DDD</label><input id="telefone" name="telefone" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="16" value={telFormatado} data-mascara="tel" /></div>
        </div>
        <div class="campo">
          <label for="email">E-mail</label>
          <input id="email" type="email" value={cliente.email} disabled />
          <span class="ajuda">{cliente.email_verificado ? 'E-mail confirmado.' : 'E-mail ainda não confirmado: confirme em Meus pedidos.'} Para trocar o e-mail, fale com a gente.</span>
        </div>
        <details class="trocar-senha">
          <summary>Trocar a senha</summary>
          <div class="linha-campos duas">
            <div class="campo">
              <label for="senha_atual">Senha atual</label>
              <div class="campo-senha"><input id="senha_atual" name="senha_atual" type="password" autocomplete="current-password" maxlength="128" /><button type="button" class="ver-senha" data-ver-senha aria-pressed="false" aria-label="Mostrar senha"><Simbolo nome="olho" tamanho={20} /></button></div>
            </div>
            <div class="campo">
              <label for="senha_nova">Nova senha</label>
              <div class="campo-senha"><input id="senha_nova" name="senha_nova" type="password" autocomplete="new-password" minlength="8" maxlength="128" /><button type="button" class="ver-senha" data-ver-senha aria-pressed="false" aria-label="Mostrar senha"><Simbolo nome="olho" tamanho={20} /></button></div>
              <span class="ajuda">Pelo menos 8 caracteres. As outras sessões abertas são encerradas.</span>
            </div>
          </div>
        </details>
        <p class="aviso aviso-erro" data-erro hidden role="alert"></p>
        <p class="aviso aviso-ok" data-ok hidden role="status">Dados salvos.</p>
        <div><button class="botao botao-escuro" type="submit">Salvar alterações</button></div>
      </form>
    )}
  </PainelConta>
</Base>
<style>
  .cartao-form { border: 1px solid var(--cinza-2); border-radius: var(--r-card); padding: 20px; display: flex; flex-direction: column; gap: 16px; }
  .campo input:disabled { background: var(--cinza-1); color: var(--cinza-3); }
  .trocar-senha summary { cursor: pointer; font-weight: 600; font-size: 14.5px; padding: 4px 0 12px; }
</style>
<script>
  import '../../scripts/formConta';
  const form = document.querySelector<HTMLFormElement>('[data-form-conta]');
  form?.addEventListener('conta-ok', () => {
    const ok = form.querySelector<HTMLElement>('[data-ok]')!;
    ok.hidden = false;
    for (const id of ['senha_atual', 'senha_nova']) { const c = form.querySelector<HTMLInputElement>(`#${id}`); if (c) c.value = ''; }
    setTimeout(() => (ok.hidden = true), 4000);
  });
</script>
