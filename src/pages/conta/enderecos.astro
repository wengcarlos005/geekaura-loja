---
import Base from '../../layouts/Base.astro';
import PainelConta from '../../components/PainelConta.astro';
import { clienteAtual, gravarSessao, lerSessao, listarEnderecos, type Endereco } from '../../lib/conta';
import { envDe } from '../../lib/api';
import { UFS } from '../../lib/formato';

const env = envDe(Astro);
const sessao = await lerSessao(Astro);
const cliente = await clienteAtual(env, sessao).catch(() => undefined);
if (!sessao || cliente === null) { await gravarSessao(Astro, null); return Astro.redirect('/entrar?volta=/conta/enderecos', 303); }
let enderecos: Endereco[] = [];
let falhou = false;
try { enderecos = await listarEnderecos(env, sessao); } catch { falhou = true; }
---
<Base titulo="Endereços" descricao="Seus endereços na Geek Aura." noindex>
  <PainelConta atual="enderecos" nome={cliente?.nome ?? sessao.n} email={cliente?.email ?? ''}>
    <div class="cabeca-end">
      <h1>Endereços</h1>
      <button class="botao botao-escuro" type="button" data-novo>+ Novo endereço</button>
    </div>
    {falhou && <p class="aviso aviso-info">Não conseguimos carregar seus endereços agora. Atualize a página em instantes.</p>}
    <ul class="enderecos" data-lista data-enderecos={JSON.stringify(enderecos)}></ul>
    <p class="nota" data-vazio hidden>Nenhum endereço salvo ainda. Salve um para preencher o checkout com um toque.</p>

    <form class="form-endereco" data-form-endereco hidden novalidate>
      <h2 data-form-titulo>Novo endereço</h2>
      <input type="hidden" name="id" />
      <div class="linha-campos duas">
        <div class="campo"><label for="apelido">Apelido</label><input id="apelido" name="apelido" maxlength="30" placeholder="Casa, Trabalho…" /></div>
        <div class="campo"><label for="end-nome">Quem recebe</label><input id="end-nome" name="nome" maxlength="80" autocomplete="name" required /></div>
      </div>
      <div class="linha-campos duas">
        <div class="campo"><label for="end-cep">CEP</label><input id="end-cep" name="cep" inputmode="numeric" autocomplete="postal-code" maxlength="9" placeholder="00000-000" required /><span class="ajuda" data-cep-ajuda>Preenchemos a rua para você.</span></div>
      </div>
      <div class="linha-campos tres">
        <div class="campo"><label for="end-logradouro">Rua</label><input id="end-logradouro" name="logradouro" maxlength="120" required /></div>
        <div class="campo"><label for="end-numero">Número</label><input id="end-numero" name="numero" maxlength="20" required /></div>
        <div class="campo"><label for="end-complemento">Complemento</label><input id="end-complemento" name="complemento" maxlength="80" /></div>
      </div>
      <div class="linha-campos tres">
        <div class="campo"><label for="end-bairro">Bairro</label><input id="end-bairro" name="bairro" maxlength="80" required /></div>
        <div class="campo"><label for="end-cidade">Cidade</label><input id="end-cidade" name="cidade" maxlength="80" required /></div>
        <div class="campo"><label for="end-uf">UF</label><select id="end-uf" name="uf" required><option value="">—</option>{UFS.map(u => <option value={u}>{u}</option>)}</select></div>
      </div>
      <label class="aceite"><input type="checkbox" name="padrao" /> <span>Usar como endereço principal</span></label>
      <p class="aviso aviso-erro" data-erro hidden role="alert"></p>
      <div class="acoes-form">
        <button class="botao botao-primario" type="submit">Salvar endereço</button>
        <button class="botao botao-contorno" type="button" data-cancelar>Cancelar</button>
      </div>
    </form>
  </PainelConta>
</Base>
<style>
  .cabeca-end { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
  .cabeca-end .botao { height: 42px; }
  .enderecos { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 700px) { .enderecos { grid-template-columns: 1fr 1fr; } }
  .enderecos :global(.end) { border: 1px solid var(--cinza-2); border-radius: var(--r-card); padding: 16px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; line-height: 1.45; }
  .enderecos :global(.end.padrao) { border-color: var(--abobora); box-shadow: inset 0 0 0 1px var(--abobora); }
  .enderecos :global(.end-topo) { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
  .enderecos :global(.end-apelido) { font-family: var(--fonte-titulo); font-weight: 600; font-size: 17px; }
  .enderecos :global(.end-selo) { background: var(--abobora); color: var(--noite); font-size: 11.5px; font-weight: 700; border-radius: var(--r-selo); padding: 3px 8px; }
  .enderecos :global(.end-acoes) { display: flex; gap: 14px; margin-top: 6px; }
  .enderecos :global(.end-acoes button) { border: 0; background: none; padding: 0; font-size: 13.5px; font-weight: 600; text-decoration: underline; cursor: pointer; color: var(--noite); }
  .enderecos :global(.end-acoes .apagar) { color: var(--erro); }
  .form-endereco { border: 1px solid var(--cinza-2); border-radius: var(--r-card); padding: 20px; display: flex; flex-direction: column; gap: 14px; animation: surgir .3s ease; }
  .form-endereco[hidden] { display: none; }
  .form-endereco h2 { font-size: 22px; font-weight: 600; }
  .acoes-form { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
<script>
  import { enviarJson, lerForm, mostrarErro } from '../../scripts/formConta';
  import { avisar } from '../../scripts/loja';
  import { cepValido } from '../../lib/formato';

  type End = { id: string; apelido: string; nome: string; cep: string; logradouro: string; numero: string; complemento: string; bairro: string; cidade: string; uf: string; padrao: boolean };
  const lista = document.querySelector<HTMLElement>('[data-lista]')!;
  const vazio = document.querySelector<HTMLElement>('[data-vazio]')!;
  const form = document.querySelector<HTMLFormElement>('[data-form-endereco]')!;
  let enderecos: End[] = JSON.parse(lista.dataset.enderecos || '[]');

  const t = (tag: string, classe: string, texto?: string) => { const e = document.createElement(tag); e.className = classe; if (texto !== undefined) e.textContent = texto; return e; };
  function desenhar() {
    lista.replaceChildren();
    vazio.hidden = enderecos.length > 0;
    for (const e of enderecos) {
      const li = t('li', `end${e.padrao ? ' padrao' : ''}`);
      li.dataset.revelar = '';
      const topo = t('div', 'end-topo');
      topo.append(t('span', 'end-apelido', e.apelido));
      if (e.padrao) topo.append(t('span', 'end-selo', 'Principal'));
      const cep = `${e.cep.slice(0, 5)}-${e.cep.slice(5)}`;
      li.append(topo, t('span', '', e.nome), t('span', '', `${e.logradouro}, ${e.numero}${e.complemento ? ` · ${e.complemento}` : ''}`), t('span', 'nota', `${e.bairro} · ${e.cidade}/${e.uf} · CEP ${cep}`));
      const acoes = t('div', 'end-acoes');
      const editar = t('button', '', 'Editar') as HTMLButtonElement; editar.type = 'button'; editar.dataset.editar = e.id;
      const apagar = t('button', 'apagar', 'Apagar') as HTMLButtonElement; apagar.type = 'button'; apagar.dataset.apagar = e.id;
      acoes.append(editar, apagar);
      li.append(acoes);
      lista.append(li);
    }
  }

  function abrirForm(e?: End) {
    form.reset();
    mostrarErro(form, null);
    form.querySelector('[data-form-titulo]')!.textContent = e ? 'Editar endereço' : 'Novo endereço';
    if (e) {
      for (const [k, v] of Object.entries(e)) {
        const campo = form.elements.namedItem(k) as HTMLInputElement | null;
        if (!campo) continue;
        if (campo.type === 'checkbox') campo.checked = !!v; else campo.value = k === 'cep' ? `${String(v).slice(0, 5)}-${String(v).slice(5)}` : String(v);
      }
    }
    form.hidden = false;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    (form.elements.namedItem(e ? 'apelido' : 'nome') as HTMLInputElement).focus({ preventScroll: true });
  }

  document.querySelector('[data-novo]')?.addEventListener('click', () => abrirForm());
  form.querySelector('[data-cancelar]')?.addEventListener('click', () => { form.hidden = true; });
  lista.addEventListener('click', async ev => {
    const alvo = ev.target as HTMLElement;
    const ed = alvo.closest<HTMLElement>('[data-editar]');
    if (ed) { abrirForm(enderecos.find(x => x.id === ed.dataset.editar)); return; }
    const ap = alvo.closest<HTMLButtonElement>('[data-apagar]');
    if (!ap || !confirm('Apagar este endereço?')) return;
    ap.disabled = true;
    const d = await enviarJson('/api/conta/enderecos', { acao: 'apagar', id: ap.dataset.apagar }).catch(() => ({ ok: false }));
    if (!d.ok) { ap.disabled = false; avisar(d.error || 'Não foi possível apagar.'); return; }
    enderecos = d.enderecos; desenhar(); avisar('Endereço apagado.');
  });

  form.addEventListener('submit', async ev => {
    ev.preventDefault();
    if (!form.reportValidity()) return;
    const dados = lerForm(form);
    const id = String(dados.id || '') || undefined;
    delete dados.id;
    const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    botao.disabled = true;
    const d = await enviarJson('/api/conta/enderecos', { acao: 'salvar', id, endereco: dados }).catch(() => ({ ok: false, error: 'Sem conexão.' }));
    botao.disabled = false;
    if (!d.ok) { mostrarErro(form, d.error || 'Não foi possível salvar.'); return; }
    enderecos = d.enderecos; desenhar(); form.hidden = true; avisar('Endereço salvo.');
  });

  // CEP preenche rua, bairro, cidade e UF pelo ViaCEP (o mesmo do checkout).
  const cep = form.querySelector<HTMLInputElement>('#end-cep')!;
  const ajuda = form.querySelector<HTMLElement>('[data-cep-ajuda]')!;
  cep.addEventListener('input', async () => {
    cep.value = cep.value.replace(/\D/g, '').slice(0, 8).replace(/(\d{5})(\d)/, '$1-$2');
    const limpo = cepValido(cep.value);
    if (!limpo) return;
    ajuda.textContent = 'Buscando endereço…';
    try {
      const r = await (await fetch(`https://viacep.com.br/ws/${limpo}/json/`)).json();
      if (r.erro) { ajuda.textContent = 'CEP não encontrado. Preencha à mão.'; return; }
      const por: Record<string, string> = { logradouro: r.logradouro, bairro: r.bairro, cidade: r.localidade, uf: r.uf };
      for (const [k, v] of Object.entries(por)) { const c = form.elements.namedItem(k) as HTMLInputElement; if (v && c && !c.value) c.value = v; }
      ajuda.textContent = 'Endereço encontrado. Confira e complete o número.';
      (form.elements.namedItem('numero') as HTMLInputElement).focus();
    } catch { ajuda.textContent = 'Não conseguimos buscar o CEP. Preencha à mão.'; }
  });

  desenhar();
</script>
