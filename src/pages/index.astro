---
import Base from '../layouts/Base.astro';
import Beneficios from '../components/Beneficios.astro';
import Carrossel from '../components/Carrossel.astro';
import Trilho from '../components/Trilho.astro';
import Foto from '../components/Foto.astro';
import Simbolo from '../components/Simbolo.astro';
import { catalogo, type ProdutoResumo } from '../lib/ryzo';
import { envDe } from '../lib/api';
import { categoriasDoCatalogo, FAIXAS, LOJA } from '../lib/loja';
import { naFaixa } from '../lib/listagem';
import { escolherDestaques, sementeDoPeriodo } from '../lib/vitrine';
import { precoBRL, slugificar } from '../lib/formato';

const env = envDe(Astro);
let produtos: ProdutoResumo[] = [];
let falhou = false;
try { produtos = await catalogo(env); } catch { falhou = true; }

const categorias = categoriasDoCatalogo(produtos);
const disponiveis = produtos.filter(p => p.disponivel);
const daCategoria = (slug: string) => disponiveis.filter(p => slugificar(p.categoria) === slug);
const achar = (teste: (p: ProdutoResumo) => boolean) => disponiveis.find(teste);
const fotosDe = (p: ProdutoResumo | undefined, n: number) =>
  p ? [...new Set([...p.variacoes.filter(v => v.estoque > 0).map(v => v.foto), ...p.fotos].filter(Boolean) as string[])].slice(0, n) : [];

// Slides do topo: cada um só entra se o catálogo tiver o produto que ele mostra.
const navio = achar(p => p.slug.startsWith('navio')) ?? daCategoria('blocos-de-montar')[0];
const dino = achar(p => /dinossauro|dino/i.test(p.titulo));
const ninja = achar(p => /ninja/i.test(p.titulo));
const natal = daCategoria('natal')[0];
const cartas = daCategoria('jogos-de-cartas');
const fotosHeroi = [...fotosDe(dino, 1), ...fotosDe(ninja, 1)];
const fotosNatal = fotosDe(natal, 3);
const fotosCartas = cartas.flatMap(p => fotosDe(p, 1)).slice(0, 3);
const menorNatal = natal ? natal.preco_a_partir : 0;

// Categorias com foto e contagem.
const fundos = ['creme', 'noite', 'abobora', 'cinza', 'aura'];
const cats = categorias.map((c, i) => {
  const lista = produtos.filter(p => slugificar(p.categoria) === c.slug);
  const capa = lista.find(p => p.disponivel && p.fotos[0]) ?? lista.find(p => p.fotos[0]);
  return { ...c, qtd: lista.length, foto: capa?.fotos[0] ?? null, fundo: fundos[i % fundos.length] };
});

// Faixas de preço com até 3 miniaturas de produtos que caem nelas.
const faixas = FAIXAS.map(f => {
  const lista = naFaixa(disponiveis, f.slug);
  return { ...f, qtd: lista.length, fotos: lista.map(p => p.fotos[0]).filter(Boolean).slice(0, 3) as string[] };
}).filter(f => f.qtd > 0);

// Destaques giram a cada 6 horas e intercalam categorias; a fileira de baratos não repete nenhum deles.
const semente = sementeDoPeriodo();
const destaques = escolherDestaques(disponiveis, 12, semente);
const jaMostrados = new Set(destaques.map(p => p.slug));
const baratos = escolherDestaques(disponiveis.filter(p => p.preco_a_partir < 60), 12, semente + 1, jaMostrados);

// Coleções: produtos com muitos modelos rendem uma vitrine de fotos.
const colecoes = disponiveis
  .filter(p => p.variacoes.filter(v => v.foto && v.estoque > 0).length >= 4)
  .sort((a, b) => b.variacoes.length - a.variacoes.length)
  .slice(0, 2)
  .map(p => ({ p, fotos: fotosDe(p, 4), modelos: p.variacoes.length }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: LOJA.nome,
  legalName: LOJA.razaoSocial,
  url: LOJA.url,
  logo: `${LOJA.url}/favicon-512.png`,
  email: LOJA.email,
  taxID: LOJA.cnpj,
};
---
<Base
  titulo={LOJA.nome}
  descricao="Blocos de montar, jogos de cartas e colecionáveis com preço de site, menor que nos marketplaces. Pix na hora, cartão e boleto pelo Mercado Pago."
  atual="inicio"
  jsonLd={jsonLd}
>
  <div class="recipiente topo-home">
    <Carrossel rotulo="Destaques da Geek Aura">
      <div class="slide slide-abobora">
        <div class="s-texto">
          <p class="s-sobre s-entra">Loja oficial Geek Aura</p>
          <h1 class="s-titulo s-entra" style="--d:1">Peças para montar o fim de semana inteiro<span class="ponto">.</span></h1>
          <p class="s-sub s-entra" style="--d:2">Preço de site, em média 10% abaixo dos marketplaces. Pix aprovado na hora e envio para todo o Brasil.</p>
          <div class="s-acoes s-entra" style="--d:3">
            <a class="botao botao-escuro" href="/produtos">Ver todos os produtos</a>
            <a class="link-forte" href="/categoria/blocos-de-montar">Blocos de montar</a>
          </div>
        </div>
        <div class="s-arte arte-mascote" aria-hidden="true">
          <span class="halo"></span>
          <img class="mascote flutua devagar" src="/img/auri-640.webp" width="640" height="640" alt="" fetchpriority="high" />
          {fotosHeroi[0] && <span class="bolha bolha-1 flutua" style="--giro:-6deg"><img src={fotosHeroi[0]} alt="" width="160" height="160" referrerpolicy="no-referrer" /></span>}
          {fotosHeroi[1] && <span class="bolha bolha-2 flutua atraso" style="--giro:5deg"><img src={fotosHeroi[1]} alt="" width="160" height="160" referrerpolicy="no-referrer" /></span>}
        </div>
      </div>

      {navio && (
        <div class="slide slide-noite">
          <div class="s-texto">
            <p class="s-sobre s-entra">Blocos de montar</p>
            <h2 class="s-titulo s-entra" style="--d:1">{navio.titulo}</h2>
            <p class="s-sub s-entra" style="--d:2">Montagem para a família inteira, com peças compatíveis com as marcas conhecidas.</p>
            <div class="s-acoes s-entra" style="--d:3">
              <a class="botao botao-primario" href={`/produto/${navio.slug}`}>Ver o produto</a>
              <span class="s-preco">{precoBRL(navio.preco_a_partir)}</span>
            </div>
          </div>
          <div class="s-arte arte-produto" aria-hidden="true">
            <svg class="gomos gira" viewBox="0 0 300 300"><path d="M150 0 C90 70 90 230 150 300 M150 0 C210 70 210 230 150 300 M150 0 C40 60 40 240 150 300 M150 0 C260 60 260 240 150 300" fill="none" stroke="#FF8A1F" stroke-opacity=".35" stroke-width="1.5" /></svg>
            <div class="moldura flutua devagar"><Foto src={navio.fotos[0]} alt="" nome={navio.titulo} tamanho={520} carregar="eager" /></div>
          </div>
        </div>
      )}

      {natal && fotosNatal.length >= 2 && (
        <div class="slide slide-creme">
          <div class="s-texto">
            <p class="s-sobre s-entra">Coleção de Natal</p>
            <h2 class="s-titulo s-entra" style="--d:1">Micro blocos para decorar a casa e presentear</h2>
            <p class="s-sub s-entra" style="--d:2">Boneco de neve, trenó, duende e mais. A partir de {precoBRL(menorNatal)} cada.</p>
            <div class="s-acoes s-entra" style="--d:3"><a class="botao botao-escuro" href="/categoria/natal">Ver a coleção</a></div>
          </div>
          <div class="s-arte arte-mosaico" aria-hidden="true">
            {fotosNatal.map((f, i) => <span class:list={['peca', `peca-${i + 1}`, 'flutua', { atraso: i % 2 === 1 }]} style={`--giro:${[-4, 3, -2][i]}deg`}><img src={f} alt="" width="220" height="220" referrerpolicy="no-referrer" /></span>)}
          </div>
        </div>
      )}

      {fotosCartas.length >= 2 && (
        <div class="slide slide-aura">
          <div class="s-texto">
            <p class="s-sobre s-entra">Jogos de cartas</p>
            <h2 class="s-titulo s-entra" style="--d:1">Para a mesa de sábado, de 2 a 10 jogadores</h2>
            <p class="s-sub s-entra" style="--d:2">Partidas rápidas, regras simples e muita risada. Bom para levar na viagem.</p>
            <div class="s-acoes s-entra" style="--d:3"><a class="botao botao-primario" href="/categoria/jogos-de-cartas">Ver os jogos</a></div>
          </div>
          <div class="s-arte arte-leque" aria-hidden="true">
            {fotosCartas.map((f, i) => <span class:list={['carta', `carta-${i + 1}`]}><img src={f} alt="" width="240" height="240" referrerpolicy="no-referrer" /></span>)}
          </div>
        </div>
      )}
    </Carrossel>
  </div>

  <Beneficios />

  {cats.length > 1 && (
    <section class="recipiente secao" aria-labelledby="titulo-cats" data-trilho-secao>
      <div class="trilho-cabeca">
        <div data-revelar="esquerda"><p class="sobrelinha">Explore</p><h2 id="titulo-cats">Compre por categoria</h2></div>
        <a class="ver-todos" href="/produtos">Ver tudo <Simbolo nome="direita" tamanho={18} /></a>
      </div>
      <div class="trilho-moldura">
      {cats.length > 5 && <button type="button" class="seta seta-esq" data-seta="-1" aria-label="Categorias anteriores" disabled><Simbolo nome="esquerda" tamanho={22} /></button>}
      {cats.length > 5 && <button type="button" class="seta seta-dir" data-seta="1" aria-label="Mais categorias"><Simbolo nome="direita" tamanho={22} /></button>}
      <div class="cats" data-trilho>
        {cats.map(c => (
          <a class:list={['cat', `cat-${c.fundo}`]} href={`/categoria/${c.slug}`} data-revelar>
            <span class="cat-texto"><span class="cat-nome">{c.nome}</span><span class="cat-qtd">{c.qtd} {c.qtd === 1 ? 'produto' : 'produtos'}</span></span>
            {c.foto && <span class="cat-foto"><img src={c.foto} alt="" width="200" height="200" loading="lazy" referrerpolicy="no-referrer" /></span>}
            <span class="cat-seta" aria-hidden="true"><Simbolo nome="direita" tamanho={18} /></span>
          </a>
        ))}
      </div>
      </div>
    </section>
  )}

  {falhou ? (
    <section class="recipiente secao"><p class="aviso aviso-info">Não conseguimos carregar os produtos agora. Atualize a página em instantes.</p></section>
  ) : (
    <Trilho id="destaques" sobrelinha="Escolhidos a dedo" titulo="Destaques da loja" produtos={destaques} verTodos={{ href: '/produtos', rotulo: 'Ver todos' }} />
  )}

  {faixas.length > 0 && (
    <section class="recipiente secao" aria-labelledby="titulo-faixas">
      <div class="trilho-cabeca"><div data-revelar="esquerda"><p class="sobrelinha">Cabe no bolso</p><h2 id="titulo-faixas">Compre por faixa de preço</h2></div></div>
      <div class="faixas">
        {faixas.map((f, i) => (
          <a class:list={['faixa', `faixa-${i + 1}`]} href={`/produtos?faixa=${f.slug}`} data-revelar>
            <span class="faixa-rotulo">{f.nome}</span>
            <span class="faixa-qtd">{f.qtd} {f.qtd === 1 ? 'produto' : 'produtos'}</span>
            <span class="faixa-fotos" aria-hidden="true">
              {f.fotos.map(src => <span><img src={src} alt="" width="80" height="80" loading="lazy" referrerpolicy="no-referrer" /></span>)}
            </span>
            <span class="faixa-seta" aria-hidden="true"><Simbolo nome="direita" tamanho={20} /></span>
          </a>
        ))}
      </div>
    </section>
  )}

  {colecoes.length > 0 && (
    <section class="recipiente secao" aria-labelledby="titulo-colecoes">
      <div class="trilho-cabeca"><div data-revelar="esquerda"><p class="sobrelinha">Para colecionar</p><h2 id="titulo-colecoes">Monte a coleção completa</h2></div></div>
      <div class="colecoes">
        {colecoes.map((c, i) => (
          <a class:list={['colecao', i === 0 ? 'colecao-escura' : 'colecao-creme']} href={`/produto/${c.p.slug}`} data-revelar="zoom">
            <span class="colecao-texto">
              <span class="colecao-qtd">{c.modelos} modelos</span>
              <span class="colecao-nome">{c.p.titulo}</span>
              <span class="colecao-preco">A partir de {precoBRL(c.p.preco_a_partir)}</span>
              <span class="colecao-link">Escolher modelos <Simbolo nome="direita" tamanho={18} /></span>
            </span>
            <span class="colecao-grade" aria-hidden="true">
              {c.fotos.map(f => <span><img src={f} alt="" width="200" height="200" loading="lazy" referrerpolicy="no-referrer" /></span>)}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <Trilho id="baratos" sobrelinha="Presente sem pesar" titulo="Até R$ 60" produtos={baratos} verTodos={{ href: '/produtos?ordem=menor', rotulo: 'Ver por preço' }} />

  <section class="recipiente secao">
    <div class="confianca" data-revelar>
      <div class="nota-loja">
        <span class="nota-numero">{LOJA.notaShopee}</span>
        <span class="estrelas" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Simbolo nome="estrela" tamanho={20} />)}</span>
        <span class="nota-texto">Nota da Geek Aura na Shopee, dada por quem já comprou</span>
      </div>
      <ul class="confianca-itens">
        <li><Simbolo nome="pacote" tamanho={24} /><span><strong>Conferido peça por peça</strong>Separação cuidadosa antes de cada envio</span></li>
        <li><Simbolo nome="caminhao" tamanho={24} /><span><strong>Postagem em até 2 dias úteis</strong>Rastreio pelo site e por e-mail</span></li>
        <li><Simbolo nome="cadeado" tamanho={24} /><span><strong>Pagamento pelo Mercado Pago</strong>Seu cartão não passa pela loja</span></li>
      </ul>
    </div>
  </section>

  <section class="recipiente historia">
    <div class="historia-caixa" data-revelar>
      <img class="historia-mascote flutua devagar" src="/img/auri-320.webp" width="200" height="200" alt="" loading="lazy" />
      <div class="historia-texto">
        <h2>Do marketplace para o seu site</h2>
        <p>A Geek Aura começou vendendo na Shopee e no Mercado Livre. O site é o mesmo estoque, com o mesmo cuidado na separação, e com preço menor porque aqui não pagamos comissão de marketplace.</p>
        <div class="historia-acoes">
          <a class="botao botao-primario" href="/produtos">Começar a comprar</a>
          <a class="link-forte" href={LOJA.whatsappLink} rel="noopener" target="_blank">Tirar dúvida no WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .topo-home { padding-top: 16px; }
  @media (min-width: 900px) { .topo-home { padding-top: 22px; } }

  /* ---------- Slides ---------- */
  .slide { display: grid; grid-template-rows: auto 1fr; min-height: 470px; }
  @media (min-width: 900px) { .slide { grid-template-columns: 1.05fr 1fr; grid-template-rows: none; min-height: 440px; } }
  @media (min-width: 1200px) { .slide { min-height: 480px; } }
  .slide-abobora { background: var(--abobora); color: var(--noite); }
  .slide-noite { background: var(--noite); color: var(--branco); }
  .slide-creme { background: var(--creme); color: var(--noite); }
  .slide-aura { background: #2B1D5C; color: var(--branco); }
  .s-texto { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; gap: 10px; padding: 22px 18px 4px; }
  @media (min-width: 900px) { .s-texto { padding: 48px 24px 64px 56px; gap: 18px; } }
  .s-sobre { font-size: 12.5px; font-weight: 600; letter-spacing: 1.6px; text-transform: uppercase; }
  .slide-noite .s-sobre, .slide-aura .s-sobre { color: var(--abobora); }
  .slide-creme .s-sobre { color: var(--abobora-escura); }
  .s-titulo { font-weight: 700; font-size: 27px; line-height: 1.04; letter-spacing: -.3px; max-width: 560px; }
  @media (min-width: 600px) { .s-titulo { font-size: 42px; } }
  @media (min-width: 1200px) { .s-titulo { font-size: 54px; } }
  .ponto { color: var(--branco); }
  .s-sub { font-size: 14.5px; line-height: 1.5; max-width: 440px; opacity: .88; }
  @media (max-width: 599px) { .s-sub { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; } }
  @media (min-width: 900px) { .s-sub { font-size: 17px; } }
  .s-acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 4px; }
  .s-acoes .botao { height: 46px; padding: 0 20px; font-size: 15px; }
  @media (min-width: 900px) { .s-acoes .botao { height: 50px; padding: 0 26px; font-size: 15.5px; } }
  .slide-noite .link-forte, .slide-aura .link-forte { color: var(--branco); }
  .s-preco { font-family: var(--fonte-titulo); font-size: 28px; font-weight: 700; color: var(--abobora); }
  .s-arte { position: relative; min-height: 230px; }
  @media (max-width: 899px) {
    .slide { min-height: 0; grid-template-rows: auto 220px; }
    .s-arte { min-height: 0; }
    .s-acoes .link-forte { display: none; }
    .arte-mascote .mascote { width: 40%; bottom: 40px; }
    .arte-mascote .halo { width: 62%; top: 44%; }
    .bolha { width: 70px; }
    .bolha-1 { left: 6%; top: 4%; }
    .bolha-2 { right: 6%; top: 18%; }
  }

  .arte-mascote .halo { position: absolute; width: 78%; aspect-ratio: 1; left: 50%; top: 52%; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(255, 245, 232, .55), rgba(255, 245, 232, 0) 68%); }
  .arte-mascote .mascote { position: absolute; width: min(56%, 360px); left: 50%; bottom: 52px; translate: -50% 0; }
  @media (min-width: 900px) { .arte-mascote .mascote { width: min(78%, 400px); bottom: -10px; } }
  @media (max-width: 899px) { .bolha { width: 78px; padding: 6px; border-radius: 14px; } .bolha-1 { left: 5%; top: 6%; } .bolha-2 { right: 5%; top: 24%; } }
  .bolha { position: absolute; width: 104px; aspect-ratio: 1; background: var(--branco); border-radius: 18px; padding: 8px; box-shadow: 0 18px 36px -14px rgba(17, 16, 20, .45); }
  .bolha img { width: 100%; height: 100%; object-fit: contain; border-radius: 10px; }
  .bolha-1 { left: 6%; top: 10%; }
  .bolha-2 { right: 6%; top: 30%; }
  @media (min-width: 900px) { .bolha { width: 132px; } .bolha-1 { left: 2%; top: 16%; } .bolha-2 { right: 8%; top: 8%; } }

  .arte-produto { display: flex; align-items: center; justify-content: center; padding: 8px 22px 60px; }
  @media (max-width: 899px) { .arte-produto .moldura { width: min(62%, 240px); } .s-preco { font-size: 24px; } }
  @media (min-width: 900px) { .arte-produto { padding: 40px 56px 64px 0; } }
  .gomos { position: absolute; width: 90%; height: 120%; left: 5%; top: -10%; opacity: .9; }
  .gira { animation: girar 60s linear infinite; }
  .moldura { position: relative; width: min(100%, 360px); aspect-ratio: 1; border-radius: 16px; overflow: hidden; box-shadow: 0 30px 60px -24px rgba(0, 0, 0, .7); }
  .moldura :global(.foto), .moldura :global(.foto img) { background: var(--branco); }

  .arte-mosaico { padding: 8px 22px 64px; }
  @media (max-width: 899px) { .peca { width: 34%; } .peca-2 { width: 36%; } .peca-3 { width: 30%; bottom: 58px; } }
  .peca { position: absolute; width: 42%; aspect-ratio: 1; background: var(--branco); border-radius: 16px; padding: 8px; box-shadow: 0 20px 40px -18px rgba(17, 16, 20, .35); }
  .peca img { width: 100%; height: 100%; object-fit: contain; border-radius: 10px; }
  .peca-1 { left: 6%; top: 6%; }
  .peca-2 { right: 8%; top: 18%; width: 46%; }
  .peca-3 { left: 30%; bottom: 60px; width: 36%; }
  @media (min-width: 900px) { .peca { width: 38%; } .peca-2 { width: 42%; } .peca-3 { width: 32%; bottom: 40px; } }

  .arte-leque { display: flex; align-items: center; justify-content: center; padding-bottom: 64px; }
  @media (max-width: 899px) { .carta { width: 34%; padding: 6px; } }
  .carta { position: absolute; width: 44%; max-width: 230px; aspect-ratio: 3 / 4; background: var(--branco); border-radius: 14px; padding: 10px; box-shadow: 0 24px 48px -18px rgba(0, 0, 0, .6); transition: transform .5s cubic-bezier(.2, .7, .2, 1); }
  .carta img { width: 100%; height: 100%; object-fit: contain; }
  .carta-1 { transform: translateX(-46%) rotate(-12deg); }
  .carta-2 { transform: translateX(0) rotate(0deg) translateY(-10px); z-index: 2; }
  .carta-3 { transform: translateX(46%) rotate(12deg); }
  .slide-aura:hover .carta-1 { transform: translateX(-58%) rotate(-16deg); }
  .slide-aura:hover .carta-3 { transform: translateX(58%) rotate(16deg); }
  .slide-aura:hover .carta-2 { transform: translateY(-22px); }

  /* ---------- Celular: banner baixo, texto e arte lado a lado ----------
     O carrossel alto pintava a primeira tela inteira de uma cor só. No celular ele vira um banner
     de ~210px, como nos apps de loja, e as categorias e os produtos já aparecem na primeira tela. */
  @media (max-width: 899px) {
    .topo-home { padding-top: 12px; }
    .slide { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-rows: none; min-height: 210px; }
    .s-texto { padding: 18px 4px 34px 16px; gap: 8px; justify-content: center; }
    .s-sobre, .s-sub, .s-acoes .link-forte { display: none; }
    .s-titulo { font-size: 20px; line-height: 1.08; letter-spacing: 0; }
    .s-acoes { margin-top: 2px; gap: 8px 10px; }
    .s-acoes .botao { height: 36px; padding: 0 14px; font-size: 13px; }
    .s-preco { font-size: 17px; }
