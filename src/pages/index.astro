---
import Base from '../layouts/Base.astro';
import Beneficios from '../components/Beneficios.astro';
import CardProduto from '../components/CardProduto.astro';
import Foto from '../components/Foto.astro';
import { catalogo, type ProdutoResumo } from '../lib/ryzo';
import { envDe } from '../lib/api';
import { categoriasDoCatalogo, FAIXAS, LOJA } from '../lib/loja';
import { precoBRL, slugificar } from '../lib/formato';

const env = envDe(Astro);
let produtos: ProdutoResumo[] = [];
let falhou = false;
try { produtos = await catalogo(env); } catch { falhou = true; }

const categorias = categoriasDoCatalogo(produtos);
const disponiveis = produtos.filter(p => p.disponivel);
const destaques = disponiveis.slice(0, 10);
const escuro = disponiveis.find(p => p.slug.startsWith('navio')) ?? disponiveis[0];
const creme = disponiveis.find(p => slugificar(p.categoria) === 'natal') ?? disponiveis[1];
const temCartas = categorias.some(c => c.slug === 'jogos-de-cartas');
const temNatal = categorias.some(c => c.slug === 'natal');
const qtdCartas = produtos.filter(p => slugificar(p.categoria) === 'jogos-de-cartas').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: LOJA.nome,
  legalName: LOJA.razaoSocial,
  url: LOJA.url,
  logo: `${LOJA.url}/favicon-512.png`,
  email: LOJA.email,
  taxID: LOJA.cnpj,
};
---
<Base
  titulo={LOJA.nome}
  descricao="Blocos de montar, jogos de cartas e colecionáveis com preço de site, menor que nos marketplaces. Pix na hora, cartão e boleto pelo Mercado Pago."
  atual="inicio"
  jsonLd={jsonLd}
>
  <section class="recipiente heroi">
    <div class="heroi-texto">
      <p class="sobrelinha">Loja oficial Geek Aura</p>
      <h1>Peças para montar o fim de semana inteiro<span class="ponto">.</span></h1>
      <p class="heroi-sub">Navios de 554 peças, estações espaciais e robôs 2 em 1. Tudo conferido peça por peça antes do envio.</p>
      <div class="heroi-acoes">
        <a class="botao botao-primario" href="/categoria/blocos-de-montar">Ver blocos de montar</a>
        {temCartas && <a class="link-forte" href="/categoria/jogos-de-cartas">Ver jogos de cartas</a>}
      </div>
    </div>
    <div class="mosaico">
      <a class="ladrilho ladrilho-abobora" href="#destaques">
        <p class="sobrelinha-escura">Compre direto da loja</p>
        <img class="mascote" src="/img/auri-320.webp" srcset="/img/auri-320.webp 320w, /img/auri-640.webp 640w" sizes="(min-width: 900px) 300px, 46vw" width="320" height="320" alt="Auri, o mascote da Geek Aura, segurando uma sacola de compras" fetchpriority="high" />
        <div class="ladrilho-texto">
          <span class="ladrilho-titulo">Preço de site, menor que nos marketplaces</span>
          <span class="ladrilho-link">Ver os destaques</span>
        </div>
      </a>
      {escuro && (
        <a class="ladrilho ladrilho-escuro" href={`/produto/${escuro.slug}`}>
          <svg class="gomos" viewBox="0 0 300 300" preserveAspectRatio="none" aria-hidden="true"><path d="M150 0 C90 70 90 230 150 300 M150 0 C210 70 210 230 150 300 M150 0 C40 60 40 240 150 300 M150 0 C260 60 260 240 150 300" fill="none" stroke="#2A2830" stroke-width="2" /></svg>
          <div class="ladrilho-foto"><Foto src={escuro.fotos[0]} alt="" nome={escuro.titulo} tamanho={300} carregar="eager" /></div>
          <div class="ladrilho-rodape"><span>{escuro.titulo}</span><span class="etiqueta-preco">{precoBRL(escuro.preco_a_partir)}</span></div>
        </a>
      )}
      {creme && (
        <a class="ladrilho ladrilho-creme" href={`/produto/${creme.slug}`}>
          <div class="ladrilho-foto"><Foto src={creme.fotos[0]} alt="" nome={creme.titulo} tamanho={300} carregar="eager" /></div>
          <div class="ladrilho-rodape"><span>{creme.titulo}</span><span class="preco-pequeno">{precoBRL(creme.preco_a_partir)}</span></div>
        </a>
      )}
    </div>
  </section>

  <Beneficios />

  <section class="recipiente secao" id="destaques">
    <div class="secao-cabeca">
      <h2>Destaques da loja</h2>
      {categorias.length > 1 && (
        <div class="abas" role="tablist" aria-label="Filtrar destaques" data-abas>
          <button type="button" role="tab" aria-selected="true" data-filtro="">Todos</button>
          {categorias.map(c => <button type="button" role="tab" aria-selected="false" data-filtro={c.nome}>{c.nome}</button>)}
        </div>
      )}
    </div>
    {falhou ? (
      <p class="aviso aviso-info">Não conseguimos carregar os produtos agora. Atualize a página em instantes.</p>
    ) : (
      <div class="grade" data-grade>
        {destaques.map((p, i) => <CardProduto produto={p} carregar={i < 4 ? 'eager' : 'lazy'} />)}
      </div>
    )}
    <p class="nota nota-precos">Preços do site em média 10% abaixo do preço da Shopee, promoções incluídas.</p>
  </section>

  <section class="recipiente secao">
    <h2 class="titulo-faixas">Compre por faixa de preço</h2>
    <div class="faixas">
      {FAIXAS.map(f => <a href={`/busca?faixa=${f.slug}`}><span>{f.nome}</span><span aria-hidden="true">→</span></a>)}
    </div>
  </section>

  {(temCartas || temNatal) && (
    <section class="recipiente vitrines">
      {temCartas && (
        <a class="vitrine vitrine-escura" href="/categoria/jogos-de-cartas">
          <svg class="gomos-laranja" viewBox="0 0 300 300" preserveAspectRatio="xMaxYMid slice" aria-hidden="true"><path d="M150 0 C90 70 90 230 150 300 M150 0 C210 70 210 230 150 300 M150 0 C40 60 40 240 150 300 M150 0 C260 60 260 240 150 300" fill="none" stroke="#FF8A1F" stroke-opacity="0.35" stroke-width="2" /></svg>
          <p class="sobrelinha-clara">Jogos de cartas</p>
          <p class="vitrine-titulo">Para a mesa de sábado, de 2 a 10 jogadores</p>
          <span class="vitrine-link">Ver {qtdCartas === 1 ? 'o jogo' : `os ${qtdCartas} jogos`}</span>
        </a>
      )}
      {temNatal && (
        <a class="vitrine vitrine-abobora" href="/categoria/natal">
          <p class="sobrelinha-escura">Natal</p>
          <p class="vitrine-titulo">Micro blocos para decorar a casa e presentear</p>
          <span class="vitrine-link">Ver a coleção</span>
        </a>
      )}
    </section>
  )}

  <section class="recipiente historia">
    <div class="historia-foto"><img src="/img/auri-320.webp" width="160" height="160" alt="" loading="lazy" /></div>
    <div>
      <h2>Do marketplace para o seu site</h2>
      <p>A Geek Aura começou vendendo na Shopee e no Mercado Livre. O site é o mesmo estoque, com o mesmo cuidado na separação, e com preço menor porque aqui não pagamos comissão de marketplace.</p>
    </div>
  </section>
</Base>

<style>
  .heroi { display: grid; gap: 24px; padding-top: 24px; padding-bottom: 28px; }
  @media (min-width: 900px) { .heroi { grid-template-columns: 1fr 1fr; padding-top: 32px; } }
  .heroi-texto { display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  .heroi h1 { font-weight: 700; font-size: 38px; line-height: 1.02; letter-spacing: -0.5px; }
  @media (min-width: 600px) { .heroi h1 { font-size: 48px; } }
  @media (min-width: 1100px) { .heroi h1 { font-size: 60px; } .heroi-texto { gap: 20px; padding-right: 24px; } }
  .ponto { color: var(--abobora); }
  .heroi-sub { font-size: 16px; line-height: 1.6; color: var(--texto-suave); max-width: 460px; }
  @media (min-width: 600px) { .heroi-sub { font-size: 17px; } }
  .heroi-acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
  .heroi-acoes .botao { height: 50px; padding: 0 28px; font-size: 16px; }

  .mosaico { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 190px 190px; gap: 10px; }
  @media (min-width: 600px) { .mosaico { grid-template-rows: 230px 230px; gap: 12px; } }
  .ladrilho { position: relative; overflow: hidden; border-radius: var(--r-card); display: flex; flex-direction: column; justify-content: space-between; padding: 14px; text-decoration: none; }
  @media (min-width: 600px) { .ladrilho { padding: 16px; } }
  .ladrilho-abobora { grid-row: span 2; background: var(--abobora); color: var(--noite); padding: 18px; }
  @media (min-width: 600px) { .ladrilho-abobora { padding: 28px; } }
  .ladrilho-abobora:hover { color: var(--noite); }
  .sobrelinha-escura { position: relative; z-index: 1; font-size: 12px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; }
  .mascote { position: absolute; right: -14%; top: 22%; width: 92%; height: auto; }
  @media (min-width: 600px) { .mascote { right: -16px; top: 44px; width: 270px; } }
  .ladrilho-texto { position: relative; display: flex; flex-direction: column; gap: 6px; max-width: 220px; }
  .ladrilho-titulo { font-family: var(--fonte-titulo); font-weight: 700; font-size: 22px; line-height: 1.02; }
  @media (min-width: 600px) { .ladrilho-titulo { font-size: 30px; } }
  .ladrilho-link { font-size: 14px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .ladrilho-escuro { background: var(--noite); color: var(--branco); }
  .ladrilho-escuro:hover { color: var(--branco); }
  .gomos { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ladrilho-foto { position: relative; flex: 1; min-height: 0; border-radius: var(--r-botao); overflow: hidden; margin-bottom: 10px; }
  .ladrilho-escuro .ladrilho-foto :global(.foto), .ladrilho-escuro .ladrilho-foto :global(.foto img) { background: #1C1B21; }
  .ladrilho-escuro .ladrilho-foto :global(.foto-reserva) { color: #9A94A0; }
  .ladrilho-creme { background: var(--creme); color: var(--noite); }
  .ladrilho-creme .ladrilho-foto :global(.foto), .ladrilho-creme .ladrilho-foto :global(.foto img) { background: var(--creme-escuro); }
  .ladrilho-rodape { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; line-height: 1.25; }
  .ladrilho-rodape > span:first-child { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  @media (max-width: 599px) { .ladrilho-rodape { flex-direction: column; align-items: flex-start; gap: 4px; } .ladrilho-rodape > span:first-child { -webkit-line-clamp: 1; } }
  @media (min-width: 600px) { .ladrilho-rodape { font-size: 14px; } }
  .etiqueta-preco { flex-shrink: 0; background: var(--abobora); color: var(--noite); border-radius: var(--r-selo); padding: 4px 8px; font-family: var(--fonte-titulo); font-weight: 700; font-size: 16px; }
  .preco-pequeno { flex-shrink: 0; font-family: var(--fonte-titulo); font-weight: 700; font-size: 17px; }

  .abas { display: flex; gap: 22px; font-size: 14.5px; font-weight: 500; overflow-x: auto; scrollbar-width: none; max-width: 100%; margin: 0 -16px; padding: 0 16px; }
  .abas button { flex-shrink: 0; white-space: nowrap; }
  @media (min-width: 768px) { .abas { margin: 0; padding: 0; flex-wrap: wrap; } }
  .abas button { background: none; border: 0; padding: 6px 0; color: var(--cinza-3); cursor: pointer; border-bottom: 2px solid transparent; }
  .abas button[aria-selected="true"] { color: var(--noite); font-weight: 600; border-bottom-color: var(--abobora); }
  .nota-precos { margin-top: 14px; }

  .titulo-faixas { font-size: 22px !important; margin-bottom: 14px; }
  .faixas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (min-width: 900px) { .faixas { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; } }
  .faixas a { border: 1px solid var(--cinza-2); border-radius: var(--r-card); padding: 16px; text-decoration: none; display: flex; justify-content: space-between; align-items: center; gap: 8px; font-family: var(--fonte-titulo); font-weight: 600; font-size: 17px; }
  @media (min-width: 600px) { .faixas a { font-size: 20px; padding: 18px 20px; } }
  .faixas a span:last-child { color: var(--abobora-escura); font-weight: 700; }
  .faixas a:hover { border-color: var(--noite); }

  .vitrines { display: grid; gap: 16px; padding-top: 32px; }
  @media (min-width: 900px) { .vitrines { grid-template-columns: 1fr 1fr; } }
  .vitrine { position: relative; overflow: hidden; border-radius: var(--r-card); padding: 28px; min-height: 210px; display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; text-decoration: none; }
  @media (min-width: 600px) { .vitrine { padding: 36px; min-height: 240px; } }
  .vitrine-escura { background: var(--noite); color: var(--branco); }
  .vitrine-escura:hover { color: var(--branco); }
  .vitrine-abobora { background: var(--abobora); color: var(--noite); }
  .vitrine-abobora:hover { color: var(--noite); }
  .gomos-laranja { position: absolute; right: -60px; top: 0; height: 100%; width: 60%; }
  .sobrelinha-clara { position: relative; font-size: 12.5px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--abobora); }
  .vitrine-titulo { position: relative; font-family: var(--fonte-titulo); font-weight: 600; font-size: 26px; line-height: 1.1; max-width: 360px; }
  @media (min-width: 600px) { .vitrine-titulo { font-size: 32px; } }
  .vitrine-link { position: relative; font-weight: 600; font-size: 15px; text-decoration: underline; text-underline-offset: 4px; }

  .historia { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 32px; padding-top: 48px; }
  .historia-foto { width: 140px; height: 140px; border-radius: var(--r-card); background: var(--creme); flex-shrink: 0; overflow: hidden; }
  @media (min-width: 600px) { .historia-foto { width: 160px; height: 160px; } }
  .historia-foto img { width: 100%; height: 100%; object-fit: contain; }
  .historia > div:last-child { flex: 1 1 420px; display: flex; flex-direction: column; gap: 10px; }
  .historia h2 { font-weight: 600; font-size: 24px; }
  .historia p { font-size: 16px; line-height: 1.6; color: var(--texto-suave); max-width: 680px; }
</style>

<script>
  // Abas dos destaques: filtram a grade que já está na página (sem nova requisição).
  const abas = document.querySelector<HTMLElement>('[data-abas]');
  const grade = document.querySelector<HTMLElement>('[data-grade]');
  abas?.addEventListener('click', e => {
    const botao = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filtro]');
    if (!botao || !grade) return;
    const filtro = botao.dataset.filtro || '';
    for (const b of abas.querySelectorAll('button')) b.setAttribute('aria-selected', String(b === botao));
    for (const card of grade.querySelectorAll<HTMLElement>('.card')) card.hidden = !!filtro && card.dataset.categoria !== filtro;
  });
</script>
