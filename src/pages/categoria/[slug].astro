---
import Base from '../../layouts/Base.astro';
import ListaDeProdutos from '../../components/ListaDeProdutos.astro';
import { catalogo } from '../../lib/ryzo';
import { envDe } from '../../lib/api';
import { slugificar } from '../../lib/formato';
import { ordenar } from '../../lib/listagem';
import { LOJA } from '../../lib/loja';
import { seoDaCategoria, trilhaJsonLd } from '../../lib/seoCategorias';

const slug = String(Astro.params.slug || '');
const todos = await catalogo(envDe(Astro));
const daCategoria = todos.filter(p => slugificar(p.categoria) === slug);
if (!daCategoria.length) return Astro.rewrite('/404');
const nome = daCategoria[0].categoria;
const seo = seoDaCategoria(slug, nome, daCategoria.length);
const jsonLd = { '@context': 'https://schema.org', ...trilhaJsonLd(LOJA.url, [{ nome, caminho: `/categoria/${slug}` }]) };
const ordem = Astro.url.searchParams.get('ordem') === 'menor' ? 'menor' : Astro.url.searchParams.get('ordem') === 'maior' ? 'maior' : '';
---
<Base titulo={seo.titulo} descricao={seo.descricao} atual={slug} jsonLd={jsonLd}>
  <ListaDeProdutos titulo={nome} produtos={ordenar(daCategoria, ordem)} ordem={ordem} vazio="Nenhum produto nesta categoria agora." sobre={seo.texto} />
</Base>
