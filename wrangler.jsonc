{
  // Worker do site. O Ryzo é outro Worker: este aqui só fala com ele pelas rotas /vitrine/v1/*.
  "name": "geekaura-loja",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  "vars": {
    // Ryzo de produção. Para testar contra o staging: https://ryzo-staging.wengcarlos005.workers.dev
    // (aqui, não no painel: a publicação pelo GitHub sobrescreve variável que só existe no painel).
    "RYZO_URL": "https://ryzoseller.com.br"
  }
  // Segredos (nunca aqui): wrangler secret put RYZO_VITRINE_KEY / CART_SECRET
}
